# Plantilla para ambiente de pruebas (Herastats)
# Copiar a `backend/.env.test`, rellenar y NO versionar ese archivo.
#
# Crear la base: ver scripts/create-test-database.sql

DB_HOST=localhost
DB_PORT=5432
DB_NAME=herastats_test
DB_USER=
DB_PASSWORD=

PORT=5001
NODE_ENV=development

# Distinto al .env de “producción local” para no reutilizar tokens entre entornos
JWT_SECRET=cambiar_secreto_solo_para_test

CORS_ORIGIN=http://localhost:3000

# Cloudinary (opcional: mismo cloud, carpeta separada)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PREFIX=staging

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_BASE_URL=http://localhost:3000

# Seed al arrancar (ver docs/ENVIRONMENTS.md)
# HERASTATS_SEED_DEFAULT_SUPERUSER=false
# HERASTATS_SEED_DEFAULT_TEST_ADMIN=false
# TEST_DEFAULT_SUPERUSER_EMAIL=bootstrap@localhost
# TEST_DEFAULT_SUPERUSER_PASSWORD=  # obligatorio si seed activo (mín. 8 en dev)
# TEST_DEFAULT_SUPERUSER_ROLE=superuser
# TEST_DEFAULT_ADMIN_EMAIL=admin@localhost
# TEST_DEFAULT_ADMIN_PASSWORD=  # obligatorio si seed de admin activo
# TEST_DEFAULT_ADMIN_ROLE=admin
