{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:test": "cross-env ENV_FILE=.env.test node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:test": "cross-env ENV_FILE=.env.test nodemon src/server.js",
    "kill-port:test": "npx --yes kill-port 5001",
    "test": "cross-env NODE_ENV=test jest --runInBand --forceExit",
    "db:procedures": "node scripts/apply-procedures.js",
    "db:procedures:extract": "node scripts/extract-procedures.js",
    "security:check": "node ../scripts/check-secrets.js",
    "deploy:verify": "node ../scripts/verify-deploy.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.16.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "globalTeardown": "./jest.teardown.js",
    "testMatch": [
      "**/__tests__/**/*.test.js",
      "**/src/**/*.test.js"
    ]
  }
}
