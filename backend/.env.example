# Herastats — variables de entorno (ejemplo)
# Copiar a `.env` y completar valores reales. No subir `.env` al repositorio.

# Base de datos PostgreSQL
# En Seenode: vincular la BD y usar DATABASE_URL (ver backend/.env.seenode.example).
# DATABASE_URL=postgres://user:pass@host:5432/herastats
# DB_SSL=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=herastats
DB_USER=
DB_PASSWORD=

# API
PORT=5000
NODE_ENV=development

# Archivo de entorno alternativo (solo referencia; se usa vía script o variable al arrancar)
# ENV_FILE=.env

# CORS: uno o varios orígenes separados por coma (sin espacios innecesarios)
CORS_ORIGIN=http://localhost:3000

# JWT (usar un secreto largo y aleatorio en producción)
JWT_SECRET=cambiar_por_secreto_seguro

# Seed al arrancar (ver docs/ENVIRONMENTS.md y docs/SECURITY_DEPLOY.md)
# En producción el seed de superusuario está DESACTIVADO salvo HERASTATS_SEED_DEFAULT_SUPERUSER=true
# HERASTATS_SEED_DEFAULT_SUPERUSER=false
# TEST_DEFAULT_SUPERUSER_EMAIL=bootstrap@localhost
# TEST_DEFAULT_SUPERUSER_PASSWORD=  # obligatorio si el seed está activo (mín. 8–10 caracteres)
# JWT_EXPIRES_IN=24h
# MIN_PASSWORD_LENGTH=10
# Admin de prueba solo si BD termina en _test y HERASTATS_SEED_DEFAULT_TEST_ADMIN no desactivado
# HERASTATS_SEED_DEFAULT_TEST_ADMIN=
# TEST_DEFAULT_ADMIN_EMAIL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Prefijo opcional para carpetas de subida (ej. staging → staging/herastats/tournaments)
# CLOUDINARY_UPLOAD_PREFIX=

# Correo (invitaciones / contraseña)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_BASE_URL=http://localhost:3000
