# Herastats — variables de entorno (ejemplo)
# Copiar a `.env` y completar valores reales. No subir `.env` al repositorio.

# Base de datos PostgreSQL
# En Seenode: vincular la BD y usar DATABASE_URL (ver backend/.env.seenode.example).
# DATABASE_URL=postgres://user:pass@host:5432/herastats
# DB_SSL=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=herastats
DB_USER=
DB_PASSWORD=

# API
PORT=5000
NODE_ENV=development

# Archivo de entorno alternativo (solo referencia; se usa vía script o variable al arrancar)
# ENV_FILE=.env

# CORS: uno o varios orígenes separados por coma (sin espacios innecesarios)
CORS_ORIGIN=http://localhost:3000

# JWT (usar un secreto largo y aleatorio en producción)
JWT_SECRET=cambiar_por_secreto_seguro

# Seed al arrancar (ver docs/SECURITY_DEPLOY.md)
# En producción el seed de superusuario está DESACTIVADO salvo HERASTATS_SEED_DEFAULT_SUPERUSER=true
# HERASTATS_SEED_DEFAULT_SUPERUSER=false
# SEED_DEFAULT_SUPERUSER_EMAIL=bootstrap@localhost
# SEED_DEFAULT_SUPERUSER_PASSWORD=  # obligatorio si el seed está activo (mín. 8–10 caracteres)

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Prefijo opcional para carpetas de subida (ej. staging → staging/herastats/tournaments)
# CLOUDINARY_UPLOAD_PREFIX=

# URL pública del sitio (sitemap, canonical en backend)
# SITE_URL=https://tudominio.com
# FRONTEND_BASE_URL=http://localhost:3000

# Analytics de visitas
# ANALYTICS_IP_SALT=cambiar_por_secreto_largo
# ANALYTICS_RETENTION_DAYS=90
# GEOIP_DB_PATH=./data/GeoLite2-Country.mmdb

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FRONTEND_BASE_URL=http://localhost:3000

# Sincronización API externa (football-data) hacia un torneo concreto (script CLI)
# npm run sync:tournament-2 -- --dry-run
TOURNAMENT_2_SYNC_ENABLED=false
# torneo_id destino en BD (local: 2; producción Seenode: 3)
TOURNAMENT_2_SYNC_TARGET_TOURNAMENT_ID=2
TOURNAMENT_2_EXTERNAL_API_BASE_URL=https://api.football-data.org/v4
TOURNAMENT_2_EXTERNAL_API_KEY=
# Header para football-data (X-Auth-Token)
TOURNAMENT_2_EXTERNAL_API_KEY_HEADER=X-Auth-Token
# En football-data no se usa prefijo (Bearer vacío)
# TOURNAMENT_2_EXTERNAL_API_KEY_PREFIX=
TOURNAMENT_2_SYNC_ACTOR_USER_ID=
# Endpoints football-data (WC)
TOURNAMENT_2_EXTERNAL_TEAMS_PATH=/competitions/WC/teams
TOURNAMENT_2_EXTERNAL_SCHEDULE_PATH=/competitions/WC/matches
TOURNAMENT_2_EXTERNAL_SCORES_PATH=/competitions/WC/matches
# No se usa endpoint de eventos detallados en este flujo
TOURNAMENT_2_EXTERNAL_GAME_EVENTS_PATH_TEMPLATE=
# Worker in-process en backend
TOURNAMENT_2_CRON_MINUTES=30
TOURNAMENT_2_INITIAL_SEED_ON_BOOT=true
# Timeouts/reintentos
# TOURNAMENT_2_EXTERNAL_TIMEOUT_MS=15000
# TOURNAMENT_2_EXTERNAL_RETRY_COUNT=1
