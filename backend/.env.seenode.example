# Herastats — variables de entorno para Seenode (backend)
# Copiar valores a Environment del Web Service en Seenode. No subir al repositorio.

# --- Base de datos (elegir una opción) ---
# Opción A (recomendada en Seenode): vincular PostgreSQL en "Database Connections".
# Seenode inyecta DATABASE_URL automáticamente; no hace falta definir DB_*.

# Opción B: variables individuales (si no usas el enlace automático)
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSL=require

# --- API ---
NODE_ENV=production
PORT=5000

# Origen del frontend (sin barra final). Varios orígenes: separados por coma.
# Ejemplo con dominio propio + subdominio Seenode:
# CORS_ORIGIN=https://www.herastats.com,https://herastats-app-xxxx.seenode.com
CORS_ORIGIN=https://www.herastats.com

# JWT — generar con: node scripts/generate-secrets.js
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Seguridad producción
HERASTATS_SEED_DEFAULT_SUPERUSER=false
MIN_PASSWORD_LENGTH=10

# URL pública del sitio (sitemap, canonical en backend)
SITE_URL=https://www.herastats.com
FRONTEND_BASE_URL=https://www.herastats.com

# Analytics interno (dashboard /analytics)
# Generar salt: node scripts/generate-secrets.js
ANALYTICS_IP_SALT=
ANALYTICS_RETENTION_DAYS=90
# Opcional si subes GeoLite2-Country.mmdb al servicio:
# GEOIP_DB_PATH=./data/GeoLite2-Country.mmdb

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_PREFIX=production

# Correo SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Herastats <no-reply@www.herastats.com>

# Sync torneo 2 / football-data (opcional; desactivado por defecto)
# TOURNAMENT_2_SYNC_ENABLED=false
# TOURNAMENT_2_EXTERNAL_API_KEY=
