# Herastats — variables de entorno para Seenode (backend)
# Copiar valores a Environment del Web Service en Seenode. No subir al repositorio.

# --- Base de datos (elegir una opción) ---
# Opción A (recomendada en Seenode): vincular PostgreSQL en "Database Connections".
# Seenode inyecta DATABASE_URL automáticamente; no hace falta definir DB_*.
# DATABASE_URL=postgres://...

# Opción B: variables individuales (si no usas el enlace automático)
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# SSL para PostgreSQL gestionado (default en producción: activo)
# DB_SSL=false

# --- API ---
NODE_ENV=production


# Origen del frontend desplegado (sin barra final). Varios orígenes: separados por coma.
CORS_ORIGIN=https://tu-frontend.seenode.com

# JWT — generar con: node scripts/generate-secrets.js
JWT_SECRET=<genera uno con: node scripts/generate-secrets.js>
JWT_EXPIRES_IN=8h

# Seguridad producción
HERASTATS_SEED_DEFAULT_SUPERUSER=false
MIN_PASSWORD_LENGTH=10

# URL pública del frontend (enlaces de correo / set-password)
FRONTEND_BASE_URL=https://tu-frontend.seenode.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_PREFIX=production

# Correo SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Herastats <no-reply@tudominio.com>
