# Herastats — variables de entorno para Seenode (frontend)
# Definir en Environment del Web Service frontend ANTES del build (npm run build).

# URL pública del backend (incluir /api al final)
REACT_APP_API_URL=https://tu-backend.seenode.com/api

# Dominio público del SPA (canonical, Open Graph) — sin barra final
REACT_APP_SITE_URL=https://www.herastats.com

# Google Analytics 4 (opcional; solo carga tras consentimiento de cookies)
# REACT_APP_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Maps (restringir por referrer a https://www.herastats.com/* en Google Cloud)
# REACT_APP_GOOGLE_MAPS_API_KEY=
