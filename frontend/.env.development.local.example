# Desarrollo local — apuntar el frontend al API de pruebas (puerto 5001)
#
# Opción A (recomendada): no uses este archivo; ejecuta en frontend:
#   npm run start:test-api
#
# Opción B: copiar este archivo a `.env.development.local` (no se versiona) y ejecutar `npm start`.

REACT_APP_API_URL=http://localhost:5001/api
