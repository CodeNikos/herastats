# Frontend Herastats — variables opcionales (ejemplo)
# Copiar fragmentos a `.env.development.local` si hace falta. No subir secretos.

# URL del API (opcional). Si no se define, en desarrollo suele usarse http://localhost:5000/api
# salvo que el selector de entorno (esquina inferior derecha) fuerce otro perfil.
# REACT_APP_API_URL=http://localhost:5001/api

# URLs usadas por el selector «Local» y «Pruebas» en desarrollo (opcional; tienen default)
# REACT_APP_DEV_API_LOCAL=http://localhost:5000/api
# REACT_APP_DEV_API_TEST=http://localhost:5001/api

# En build de producción, definir la URL pública del API (obligatorio para npm run build):
# REACT_APP_API_URL=https://tu-dominio.com/api

# Google Maps (restringir por referrer en Google Cloud Console):
# REACT_APP_GOOGLE_MAPS_API_KEY=
