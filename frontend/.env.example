# Frontend Herastats — variables opcionales (ejemplo)
# Copiar fragmentos a `.env.development.local` si hace falta. No subir secretos.

# URL del API (opcional). Si no se define, en desarrollo se usa http://localhost:5000/api
# REACT_APP_API_URL=http://localhost:5000/api

# En build de producción, definir la URL pública del API (obligatorio para npm run build):
# REACT_APP_API_URL=https://tu-dominio.com/api

# URL pública del sitio (canonical, Open Graph, robots)
# REACT_APP_SITE_URL=https://tudominio.com

# Google Analytics 4 (opcional; solo se carga tras consentimiento del usuario)
# REACT_APP_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console: añadir meta google-site-verification en public/index.html

# Torneo Copa del Mundo (Anexo C, auto slots 3X). Local: 2. Producción: mismo id que TOURNAMENT_2_SYNC_TARGET_TOURNAMENT_ID.
# REACT_APP_FIFA_WC_TOURNAMENT_ID=2
